// SPDX-License-Identifier: GPL-2.0-or-later
// Experimental CLI-only DT; electrical values copied from this board's running DT.
/dts-v1/;
#include "rk3288.dtsi"
/ {
 model = "NORCO EMB-3533 mainline trial";
 compatible = "norco,emb3533", "rockchip,rk3288";
 memory@0 { device_type = "memory"; reg = <0 0 0 0x08400000>, <0 0x09200000 0 0x76e00000>; };
 reserved-memory {
  #address-cells = <2>; #size-cells = <2>; ranges;
  ramoops@8000000 { compatible = "ramoops"; reg = <0 0x08000000 0 0x000f0000>; record-size = <0x20000>; console-size = <0x80000>; pmsg-size = <0x50000>; };
 };
 chosen { stdout-path = "serial1:115200n8"; };
 psci { compatible = "arm,psci-1.0"; method = "smc"; };
 vcc_sys: regulator-vcc-sys { compatible = "regulator-fixed"; regulator-name = "vcc_sys"; regulator-min-microvolt = <5000000>; regulator-max-microvolt = <5000000>; regulator-always-on; regulator-boot-on; };
 vcc_sd: regulator-vcc-sd { compatible = "regulator-fixed"; regulator-name = "vcc_sd"; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-always-on; regulator-boot-on; vin-supply = <&vcc_io>; startup-delay-us = <100000>; };
 vcc_flash: regulator-vcc-flash { compatible = "regulator-fixed"; regulator-name = "vcc_flash"; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-always-on; vin-supply = <&vcc_io>; };
 ext_gmac: external-gmac-clock { compatible = "fixed-clock"; #clock-cells = <0>; clock-frequency = <125000000>; clock-output-names = "ext_gmac"; };
};
&cpu0 { enable-method = "psci"; };
&cpu1 { enable-method = "psci"; };
&cpu2 { enable-method = "psci"; };
&cpu3 { enable-method = "psci"; };
&i2c0 {
 status = "okay"; clock-frequency = <400000>;
 act8846: pmic@5a {
  compatible = "active-semi,act8846"; reg = <0x5a>;
  vp1-supply = <&vcc_sys>; vp2-supply = <&vcc_sys>; vp3-supply = <&vcc_sys>; vp4-supply = <&vcc_sys>;
  inl1-supply = <&vcc_sys>; inl2-supply = <&vcc_sys>; inl3-supply = <&vcc_20>;
  regulators {
   vcc_ddr: REG1 { regulator-name = "vcc_ddr"; regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; regulator-always-on; regulator-boot-on; };
   vcc_io: REG2 { regulator-name = "vcc_io"; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-always-on; regulator-boot-on; };
   vdd_log: REG3 { regulator-name = "vdd_log"; regulator-min-microvolt = <1100000>; regulator-max-microvolt = <1100000>; regulator-always-on; regulator-boot-on; };
   vcc_20: REG4 { regulator-name = "vcc_20"; regulator-min-microvolt = <2000000>; regulator-max-microvolt = <2000000>; regulator-always-on; regulator-boot-on; };
   vccio_sd: REG5 { regulator-name = "vccio_sd"; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-always-on; regulator-boot-on; };
   vdd10_lcd: REG6 { regulator-name = "vdd10_lcd"; regulator-min-microvolt = <1000000>; regulator-max-microvolt = <1000000>; regulator-always-on; regulator-boot-on; };
   vcca_33: REG7 { regulator-name = "vcca_33"; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-always-on; regulator-boot-on; };
   vcc_lan: REG8 { regulator-name = "vcc_lan"; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-always-on; regulator-boot-on; };
   vcc_pmu: REG9 { regulator-name = "vcc_pmu"; regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; regulator-always-on; regulator-boot-on; };
   vdd_10: REG10 { regulator-name = "vdd_10"; regulator-min-microvolt = <1000000>; regulator-max-microvolt = <1000000>; regulator-always-on; regulator-boot-on; };
   vcc_18: REG11 { regulator-name = "vcc_18"; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-always-on; regulator-boot-on; };
   vcc18_lcd: REG12 { regulator-name = "vcc18_lcd"; regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; regulator-always-on; regulator-boot-on; };
  };
 };
};
// The vendor firmware protects timer6/7 at ff810000. Its original DT uses timer0.
&timer { status = "disabled"; };
/ {
 timer0_ns: timer@ff6b0000 {
  compatible = "rockchip,rk3288-timer";
  reg = <0 0xff6b0000 0 0x20>;
  interrupts = <GIC_SPI 66 IRQ_TYPE_LEVEL_HIGH>;
  clocks = <&cru PCLK_TIMER>, <&xin24m>;
  clock-names = "pclk", "timer";
 };
};
&sdmmc {
 status = "okay"; bus-width = <4>; cap-sd-highspeed; disable-wp; no-1-8-v;
 max-frequency = <50000000>; card-detect-delay = <200>;
 vmmc-supply = <&vcc_sd>; vqmmc-supply = <&vccio_sd>;
 pinctrl-names = "default"; pinctrl-0 = <&sdmmc_clk &sdmmc_cmd &sdmmc_cd &sdmmc_bus4>;
};
&emmc { status = "disabled"; };
&io_domains {
 status = "okay"; audio-supply = <&vcca_33>; bb-supply = <&vcc_io>;
 flash0-supply = <&vcc_flash>; flash1-supply = <&vcc_lan>;
 gpio30-supply = <&vcc_io>; gpio1830-supply = <&vcc_io>; lcdc-supply = <&vcc_io>; sdcard-supply = <&vccio_sd>;
};
&gmac {
 status = "okay"; phy-mode = "rgmii"; clock_in_out = "input";
 assigned-clocks = <&cru SCLK_MAC>; assigned-clock-parents = <&ext_gmac>;
 phy-supply = <&vcc_lan>;
 snps,reset-gpio = <&gpio4 RK_PB0 GPIO_ACTIVE_LOW>; snps,reset-active-low;
 snps,reset-delays-us = <0 10000 1000000>; tx_delay = <0x17>; rx_delay = <0x17>;
 pinctrl-names = "default"; pinctrl-0 = <&rgmii_pins &phy_rst>;
};
&pinctrl {
 gmac { phy_rst: phy-rst { rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_none>; }; };
};
&uart1 { status = "okay"; };

// The on-board RTL8188EU is behind the seven-port hub on USB host1.
// Match the vendor hub reset: GPIO0_B6 stays high after pin configuration.
&usbphy { status = "okay"; };
&usb_host1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&usb_hub_reset>;
};
&pinctrl {
	usb_hub_output_high: usb-hub-output-high { output-high; };
	usb-host1 {
		usb_hub_reset: usb-hub-reset {
			rockchip,pins = <0 RK_PB6 RK_FUNC_GPIO &usb_hub_output_high>;
		};
	};
};

// Match the vendor firmware's nonsecure DMA alias. Secure efuse is not needed
// for this CLI probe (CPU DVFS is disabled and the Ethernet MAC is supplied).
&dmac_bus_s { status = "disabled"; };
&dmac_bus_ns { status = "okay"; };
&efuse { status = "disabled"; };
